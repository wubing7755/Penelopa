@namespace Penelopa.Components
@using Atlas.Blazor.Content
@using Microsoft.AspNetCore.Components.Rendering
@using Penelopa.Core.Primitives
@using Penelopa.Core.Services
@inherits AtlasContentComponent
@implements IDisposable

<div class="penelopa-tree">
    @if (_primitives.Count == 0)
    {
        <p class="penelopa-tree-empty">No primitives yet. Add one from the Tools panel.</p>
    }
    else
    {
        <ul class="penelopa-tree-list">
            @foreach (var primitive in _primitives)
            {
                @RenderNode(primitive, 0)
            }
        </ul>
    }
</div>

@code {
    private readonly List<Primitive> _primitives = new();

    [Inject]
    private IPrimitiveService PrimitiveService { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        PrimitiveService.OnChange += HandleChange;
        PrimitiveService.OnCollectionChanged += HandleCollectionChanged;
        PrimitiveService.OnSelectionChanged += HandleSelectionChanged;
        RefreshList();
    }

    private void HandleChange(Primitive primitive)
    {
        RefreshList();
        StateHasChanged();
    }

    private void HandleCollectionChanged()
    {
        RefreshList();
        StateHasChanged();
    }

    private void HandleSelectionChanged(IEnumerable<Primitive> primitives)
    {
        StateHasChanged();
    }

    private void RefreshList()
    {
        _primitives.Clear();
        _primitives.AddRange(PrimitiveService.GetAll());
    }

    private bool IsSelected(Primitive primitive)
        => PrimitiveService.GetSelection().Contains(primitive);

    private void Select(Primitive primitive)
    {
        PrimitiveService.SetSelected(primitive);
    }

    private RenderFragment RenderNode(Primitive node, int depth) => __builder =>
    {
        <li>
            <button type="button"
                    class="penelopa-tree-item @(IsSelected(node) ? "selected" : "")"
                    style="padding-left: @(12 + depth * 16)px"
                    @onclick="() => Select(node)">
                @node.Name.Value
            </button>
        </li>
        if (node is Container container && container.Children.Count > 0)
        {
            <ul class="penelopa-tree-children">
                @foreach (var child in container.Children)
                {
                    @RenderNode(child, depth + 1)
                }
            </ul>
        }
    };

    public void Dispose()
    {
        PrimitiveService.OnChange -= HandleChange;
        PrimitiveService.OnCollectionChanged -= HandleCollectionChanged;
        PrimitiveService.OnSelectionChanged -= HandleSelectionChanged;
    }
}
