root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,razor}]
indent_style = space
indent_size = 4

[*.{csproj,slnx,xml,props,targets}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml,md,config}]
indent_style = space
indent_size = 2

[*.{ts,js,css,html,scss}]
indent_style = space
indent_size = 2

[*.{ps1,sh}]
indent_style = space
indent_size = 2
