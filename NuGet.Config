<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Central package management (CPM) requires a single effective package
       source or explicit mapping; GitHub Actions runners add a default
       library-packs source, which otherwise trips NU1507. Map every package
       to nuget.org so the extra source is ignored. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
